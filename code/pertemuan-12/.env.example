# Lingkungan aplikasi: development, test, atau production.
NODE_ENV=development

# Port HTTP yang didengarkan server. Nilai tidak valid menghentikan proses.
PORT=3012

# Lokasi file database relatif terhadap direktori project.
DATABASE_URL="file:./prisma/dev.db"

# Tingkat log minimum yang ditulis: debug, info, warn, atau error.
LOG_LEVEL=info

# Origin yang diizinkan CORS, dipisah koma.
CORS_ORIGIN="http://localhost:5173,http://localhost:3000"
